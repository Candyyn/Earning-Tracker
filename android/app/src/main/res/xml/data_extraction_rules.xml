<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="livetracker.db" />
        <include domain="database" path="livetracker.db-shm" />
        <include domain="database" path="livetracker.db-wal" />
        <include domain="file" path="datastore/app_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="livetracker.db" />
        <include domain="database" path="livetracker.db-shm" />
        <include domain="database" path="livetracker.db-wal" />
        <include domain="file" path="datastore/app_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
